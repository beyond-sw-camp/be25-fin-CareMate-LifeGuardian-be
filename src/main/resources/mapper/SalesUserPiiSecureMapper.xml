<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.caremate.lifeguardian.member.mapper.SalesUserPiiSecureMapper">

    <!-- 퇴사자 개인식별정보 보안 테이블 격리 이관 -->
    <insert id="insertPiiSecure" parameterType="com.caremate.lifeguardian.member.domain.SalesUserPiiSecure">
        INSERT INTO sales_user_pii_secure (
            employee_id,
            phone,
            email,
            birth_date,
            retired_at,
            purged_at
        ) VALUES (
            #{employeeId},
            #{phone},
            #{email},
            #{birthDate},
            #{retiredAt},
            #{purgedAt}
        )
    </insert>


</mapper>
